{
  "name": "dsh-safe-session-delete",
  "version": "0.2.0",
  "description": "Delete DeepSeek Harness sessions into a recoverable trash folder with a 30-day retention window, projection-cache cleanup, and a Settings management page.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tz-Wang510/dsh-safe-session-delete.git"
  },
  "homepage": "https://github.com/tz-Wang510/dsh-safe-session-delete#readme",
  "bugs": {
    "url": "https://github.com/tz-Wang510/dsh-safe-session-delete/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "screenshots.json",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "PUBLISHING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "session",
    "delete",
    "trash",
    "recycle",
    "retention"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node test/verify-host.mjs && node test/verify-client.mjs && node test/verify-apply.mjs",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.5 <0.3.0-0",
      "dshReleases": {
        "0.2.1-rc.5": "compatible"
      }
    }
  }
}
